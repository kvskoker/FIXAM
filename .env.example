# FIXAM environment configuration
#
# This is the ONLY environment template in the repository, and the only one
# published to GitHub. Copy it to .env at the repo root -- backend, simulator
# and the scripts all read that single file:
#
#   cp .env.example .env
#
# Every value has a working default in docker-compose.yml, so the stack starts
# without this file. Those defaults are public, so set your own before exposing
# anything. Variables already present in the environment (as Docker Compose
# injects them) always win over this file.
#
# NEVER commit your filled-in .env -- it is gitignored for a reason.

# ─── Database ────────────────────────────────────────────────────────────────
DB_USER=fixam_db_admin
DB_PASSWORD=change-me
DB_NAME=fixam_db
DB_PORT=5432
# Only for running outside Docker; Compose sets this to the `postgres` service.
DB_HOST=localhost
# Upper bound on open database connections the backend may hold at once.
DB_POOL_MAX=10

# ─── Published ports ─────────────────────────────────────────────────────────
# Frontend is the one people visit; the others are for direct access/debugging.
FRONTEND_PORT=80
BACKEND_PORT=5000
SIMULATOR_PORT=4001

NODE_ENV=development

# ─── WhatsApp Business API (Meta) ────────────────────────────────────────────
# Leave blank to run without a real WhatsApp connection. The bot then logs
# outgoing messages instead of sending them, which is all the simulator needs.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Number citizens message; used to build the "share to vote" wa.me link.
BOT_PHONE_NUMBER=23233788736

# ─── Admin access ────────────────────────────────────────────────────────────
# Created automatically on first backend boot, then left alone on later
# restarts so a password changed in the dashboard is not reverted.
# Set SUPER_ADMIN_RESET_PASSWORD=true for one boot to force a reset.
# Signs admin session tokens. REQUIRED for a stable deployment: without it the
# server generates a random key at boot, so every admin is signed out whenever
# the backend restarts. Generate one with:
#
#   openssl rand -hex 32
#
SECRET=
# How long an admin session lasts before re-login is required.
ADMIN_SESSION_HOURS=12

SUPER_ADMIN_PHONE=23200000000
SUPER_ADMIN_PASSWORD=change-me-too

# ─── AI engine ─────────────────────────────────────────────────────────────────────
# Speech-to-text model for voice notes (NVIDIA Parakeet TDT, via NeMo).
# Downloaded on first start (~2.5 GB) and held in RAM for the life of the
# container. Runs on CPU; no GPU is required.
PARAKEET_MODEL=nvidia/parakeet-tdt-0.6b-v3
HUGGINGFACE_API_KEY=

# ─── Instance identity ───────────────────────────────────────────────────────
# Public address citizens see in ticket and privacy links. MUST match how the
# frontend is actually reachable -- under Docker that is FRONTEND_PORT (80),
# not the 3000 used by the non-Docker `serve` setup.
FIXAM_BASE_URL=http://localhost
# Which country this instance serves. An ISO 3166-1 alpha-2 code, not a name:
# a code has one correct spelling, a name has many. Sets the served area
# bounds, the geocoder scope, the country shown to citizens, and the phone
# numbers the bot and simulator accept (the country's calling code, at the
# country's number length).
#
# West Africa: SL LR GN GW SN GM ML BF CI GH TG BJ NE NG MR CV
FIXAM_COUNTRY_CODE=SL
FIXAM_CONTACT_EMAIL=privacy@fixam.sl
FIXAM_WEBSITE=https://fixam.sl
ALLOWED_ORIGINS=http://localhost:3000,http://localhost,http://localhost:80

# ─── Behaviour ───────────────────────────────────────────────────────────────
# true = public site shows a maintenance screen and the bot answers only admins.
DEV_MODE=false

# Caps on citizen free text, applied before anything reaches the AI or the
# database. A WhatsApp message otherwise has no practical limit.
MAX_DESCRIPTION_LENGTH=1000
MAX_ADDRESS_LENGTH=200

# Duplicate-report detection: an open issue this close, this recently, is
# flagged to the citizen before they submit.
DUPLICATE_RADIUS_METERS=100
DUPLICATE_WINDOW_DAYS=7

# Child safeguarding: photographs showing the face of a child (0-12) are
# refused and never stored. Faces are located first (NudeNet) and age-classified individually
# (SigLIP2), so a photo with no people in it is never affected.
#
# This check fails CLOSED -- if the model cannot be reached the image is
# refused, not accepted. Turning it off is a deliberate act.
MINOR_DETECTION_ENABLED=true
AGE_MODEL=prithivMLmods/Age-Classification-SigLIP2
# How sure the age model must be before a face counts as a child.
MINOR_AGE_CONFIDENCE=0.5
# How sure the face detector must be before a region is age-classified.
MINOR_FACE_CONFIDENCE=0.3

# ─── WhatsApp Simulator ──────────────────────────────────────────────────────
# Lets the backend recognise simulated conversations and mirror admin
# notifications into the simulator chat. Without it the simulator still runs,
# but status updates never reach the citizen's window.
#
# Simulated traffic is refused outright when NODE_ENV=production, so this being
# true is safe for development and testing. Set it to false for a public
# deployment anyway, as defence in depth.
SIMULATOR_ENABLED=true
SIMULATOR_URL=http://simulator:4001
SIMULATOR_PHONE=23272123456
# Point at a scratch database to keep simulated reports out of the real one.
# SIMULATOR_DB_NAME=fixam_sim_db

# ── Data retention ───────────────────────────────────────────────────────────
# How long personal data is kept, in days. These defaults are what PRIVACY.md
# publishes; a daily job enforces them. Shortening is safe, lengthening means
# the policy has to change too.
MESSAGE_LOG_RETENTION_DAYS=90
CONVERSATION_STATE_RETENTION_DAYS=7
PENDING_CONSENT_RETENTION_DAYS=30

# Diagnostic log files on disk. Shorter than message history: they exist to
# work out what went wrong recently, not to be a second copy of the
# conversation. Phone numbers in them are pseudonymised on the way in.
LOG_RETENTION_DAYS=30

# The administrative audit trail — account changes, sign-ins, exports. Kept far
# longer than the data it describes, because an audit is read after the fact.
ADMIN_AUDIT_RETENTION_DAYS=730

# ── Administrator sign-in ────────────────────────────────────────────────────
# Second factor for the portal. The administrator sends LOGIN to the FIXAM
# WhatsApp number and the bot replies with a code — admin-initiated, so no
# approved message template is required. Set to false only to recover from a
# lock-out, and set it back afterwards.
ADMIN_2FA_ENABLED=true
ADMIN_OTP_TTL_MINUTES=10
# Unused codes per account per hour. Codes that completed a sign-in do not
# count, so ordinary signing in and out never runs into this.
ADMIN_OTP_MAX_PER_HOUR=10

# ── Duplicate detection ──────────────────────────────────────────────────────
# Two reports within this distance and time are treated as candidates for the
# same problem, then compared on what they actually say. A dense market may
# want a tighter radius than a rural road.
DUPLICATE_RADIUS_METERS=100
DUPLICATE_WINDOW_DAYS=7
# Minimum embedding similarity for two nearby reports to count as duplicates.
# Lower = more eager to flag; higher = fewer, safer prompts.
DUPLICATE_SIMILARITY_THRESHOLD=0.45

# ── Geocoding ────────────────────────────────────────────────────────────────
# Addresses in, coordinates out, and coordinates back into district and ward.
# The stack runs its own Nominatim, so there is no per-second limit and no
# dependency on somebody else's service.
NOMINATIM_URL=http://nominatim:8080
NOMINATIM_TIMEOUT_MS=8000

# Delay between geocoding requests, in milliseconds. Left empty it is chosen
# from the URL: none for an instance you run, 1100ms for a public one, because
# the public service's usage policy allows about one request per second and
# exceeding it gets the whole deployment blocked. Set a number only to pace a
# self-hosted box deliberately.
NOMINATIM_MIN_INTERVAL_MS=

# Which country's map data the local instance imports. Change both together —
# the updates URL must match the extract. Browse the options at
# https://download.geofabrik.de
NOMINATIM_PBF_URL=https://download.geofabrik.de/africa/sierra-leone-latest.osm.pbf
NOMINATIM_REPLICATION_URL=https://download.geofabrik.de/africa/sierra-leone-updates/

# Import tuning. Threads should not exceed the host's cores. Shared memory
# below 1gb will fail the import partway through.
NOMINATIM_IMPORT_THREADS=4
NOMINATIM_SHM_SIZE=1gb
NOMINATIM_PORT=8080
NOMINATIM_DB_PASSWORD=fixam_nominatim

# ── Recovery ─────────────────────────────────────────────────────────────────
# Set to true for one boot to force the super admin password back to
# SUPER_ADMIN_PASSWORD, then unset it. Left unset, a changed password stays
# changed across restarts.
# SUPER_ADMIN_RESET_PASSWORD=true

# Point the simulator at a scratch database so its test conversations do not
# write users and reports into the real one.
# SIMULATOR_DB_NAME=fixam_sim

# ── Encryption ───────────────────────────────────────────────────────────────
# Encrypt the connection between the services and the database. Postgres is
# started with TLS enabled, so leave this on. See docs/ENCRYPTION.md for
# encryption at rest, which is a deployment control rather than a setting here.
DB_SSL=true
# Path to the certificate authority, when the database has a real certificate.
# Left empty, the connection is encrypted but the server is not verified.
DB_SSL_CA=
