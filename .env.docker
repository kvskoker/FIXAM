# ──────────────────────────────────────────────────────────────────────
# FIXAM — Docker Environment Variables
# Copy this file to .env and fill in your values before running:
#   docker compose up -d
#
# Optional: docker compose --profile simulator up -d   (with WhatsApp simulator)
# ──────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────
DB_USER=fixam_db_admin
DB_PASSWORD=change_me_in_production
DB_NAME=fixam_db
DB_PORT=5432

# ── Port mappings (what your browser hits) ───────────────────────────
FRONTEND_PORT=80
BACKEND_PORT=5000
SIMULATOR_PORT=4001

# ── Environment mode ─────────────────────────────────────────────────
NODE_ENV=development

# ── WhatsApp API Configuration (required for production) ─────────────
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
BOT_PHONE_NUMBER=23233788736

# ── Admin ────────────────────────────────────────────────────────────
SUPER_ADMIN_PHONE=23200000000
SUPER_ADMIN_PASSWORD=Your_Fixam@Adm1n!Password

# ── AI / ML ──────────────────────────────────────────────────────────
HUGGINGFACE_API_KEY=
WHISPER_MODEL=openai/whisper-base

# ── Application settings ─────────────────────────────────────────────
APP_URL=http://localhost:3000
DEV_MODE=false

# ── DPG Instance branding ────────────────────────────────────────────
FIXAM_BASE_URL=http://localhost:3000
FIXAM_COUNTRY=Sierra Leone
FIXAM_CONTACT_EMAIL=privacy@fixam.sl
FIXAM_WEBSITE=https://fixam.sl

# ── CORS ─────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost

# ── Simulator (use with: docker compose --profile simulator up) ──────
SIMULATOR_ENABLED=false
SIMULATOR_URL=http://simulator:4001
SIMULATOR_PHONE=23272123456
