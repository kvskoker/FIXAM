{
  "name": "fixam-backend",
  "version": "1.1.0",
  "description": "FIXAM — Civic Infrastructure Reporting Platform (Backend)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:init": "node scripts/setupDb.js init",
    "db:seed": "node scripts/setupDb.js seed",
    "db:setup": "node scripts/setupDb.js init seed",
    "db:audit-names": "node scripts/auditNames.js",
    "test": "jest --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix"
  },
  "keywords": ["civic-tech", "infrastructure", "whatsapp", "reporting"],
  "author": "FIXAM",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "axios": "^1.6.2",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "form-data": "^4.0.5",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.2.0",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/test/**/*.test.js"],
    "verbose": true,
    "clearMocks": true
  }
}
